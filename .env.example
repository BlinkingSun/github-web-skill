# Copy to .env and chmod 600. .env is gitignored — keep it that way.

# Your github.com/<login> name. Required; there is no default.
GITHUB_USER=your-login

# A token. Either `gh auth token`, or a fine-grained PAT with
# Metadata: Read-only (add "All repositories" to count private repos).
# See docs/API-SETUP.md.
GITHUB_TOKEN=github_pat_...

# Comma-separated paths to the HTML file(s) to render into.
TARGETS=/path/to/your/site/index.html

# Only used by publish.sh.example.
# SITE_REPO=/path/to/your/site
